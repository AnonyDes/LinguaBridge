{
  "name": "@linguabridge/widget",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --global-name LinguaBridgeWidget --dts",
    "test": "vitest run",
    "dev": "tsup src/index.ts --format esm,cjs,iife --global-name LinguaBridgeWidget --dts --watch"
  },
  "dependencies": {
    "@linguabridge/shared-types": "workspace:*",
    "@linguabridge/sdk-js": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
