{
  "name": "@linguabridge/mcp-server",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "linguabridge-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@linguabridge/financial-domain": "workspace:*",
    "@linguabridge/language-registry": "workspace:*",
    "@linguabridge/shared-types": "workspace:*",
    "@linguabridge/translation-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
