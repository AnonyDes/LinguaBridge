# LinguaBridge API Gateway Environment Template
API_PORT=3001
JWT_SECRET=linguabridge_development_secret_32_characters_minimum
API_KEY_SALT=linguabridge_dev_salt_2026

# Supabase / PostgreSQL Connection (Optional: in-memory cache used if omitted)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# OpenRouter (Optional: fixture & certified national lexicon used if omitted)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
ENABLE_LLM_TRANSLATION=true

# LibreTranslate (Optional self-hosted translation service)
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
