# LinguaBridge API Gateway Environment Template
API_PORT=3001
API_HOST=127.0.0.1
# Set production on a hosted API and replace the bootstrap key.
NODE_ENV=development
API_KEY=
# Stable limited key for the extension pilot. Keep separate from API_KEY.
EXTENSION_API_KEY=
CORS_ORIGINS=
REQUIRE_API_KEY=false

# Supabase / PostgreSQL connection for database tooling. API cache is in memory.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# OpenRouter (Optional: fixture & certified national lexicon used if omitted)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-6-luna
# Optional comma-separated model IDs. These are tried only when the primary errors.
OPENROUTER_FALLBACK_MODELS=
ENABLE_LLM_TRANSLATION=false

# Optional persistent speech inference service; text translation does not need it.
VOICE_SERVICE_URL=
# Optional hosted AI speech. Hausa and Nigerian Fulfulde are documented TTS languages.
ENABLE_OPENROUTER_SPEECH=false
OPENROUTER_SPEECH_MODEL=google/gemini-3.8-flash-tts
# Additional target text may yield audio, but pronunciation/variety is unreviewed.
ENABLE_EXPERIMENTAL_SPEECH=false

# Optional signed callbacks to explicitly registered HTTPS destinations.
WEBHOOK_DESTINATIONS=
WEBHOOK_SECRET=
FINANCIAL_AUDIT_WEBHOOK_URL=

# LibreTranslate (Optional self-hosted translation service)
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
