{
  "manifest_version": 3,
  "name": "LinguaBridge Accessibility Assistant",
  "version": "0.1.0",
  "description": "Multilingual accessibility and financial inclusion assistant for Cameroon web applications",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaBridge Assistant"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
