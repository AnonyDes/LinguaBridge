# Database
DATABASE_URL=postgresql://lb:lb_dev_2026@localhost:5432/linguabridge
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
JWT_SECRET=change_this_in_production_min_32_chars
API_KEY_SALT=change_this_salt_in_production

# Translation Providers
