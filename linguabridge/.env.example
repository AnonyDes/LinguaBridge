# LinguaBridge workspace environment template
# The Fastify API runs from apps/api with pnpm --filter @linguabridge/api.
# Copy apps/api/.env.example to apps/api/.env for API settings instead.
# See docs/deployment/FULL_TRANSLATION_SETUP.md for hosting and extension steps.

# Next.js web client: point at a running LinguaBridge API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional database tooling. The API's keys, quotas and cache are process-local.
DATABASE_URL=
