# ==============================================================================
# LinguaBridge — Environment Configuration Template
# Everything runs out-of-the-box locally with zero configuration!
# To deploy to production, only THREE credentials are required:
#   1. DATABASE_URL (Supabase PostgreSQL)
#   2. OPENROUTER_API_KEY (OpenRouter LLM Translation)
#   3. Vercel deployment variables (NEXT_PUBLIC_API_URL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL)
# Local fallback: Automatically falls back to high-speed in-memory cache if unset.
# Production: Paste your Supabase URI (Run infrastructure/migrations/supabase-init.sql)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. OPENROUTER API KEY (Optional LLM translation provider)
# Local fallback: Certified National Lexicon (Ewondo) & offline fixtures run locally.
# Production: Get key from https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
ENABLE_LLM_TRANSLATION=true

# ------------------------------------------------------------------------------
# 3. VERCEL & FRONTEND SETTINGS
# Local: http://localhost:3001
# Production: https://api.yourdomain.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LB_WIDGET_KEY=lb_demo_key_2026
NODE_ENV=development

# ------------------------------------------------------------------------------
# API Gateway & Security Settings
# ------------------------------------------------------------------------------
API_PORT=3001
JWT_SECRET=linguabridge_development_secret_32_characters_minimum
API_KEY_SALT=linguabridge_dev_salt_2026
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
